{
  "agentisland": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "/usr/bin/python3 __RECORD_HOOK_PATH__ --source antigravity --event PreInvocation",
        "timeout": 1
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 __RECORD_HOOK_PATH__ --source antigravity --event PostToolUse",
            "timeout": 1
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "/usr/bin/python3 __RECORD_HOOK_PATH__ --source antigravity --event Stop",
        "timeout": 1
      }
    ]
  }
}
